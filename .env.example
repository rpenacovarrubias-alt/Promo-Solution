# =============================================================
# Promo Solution — Variables de entorno
# Copia este archivo como .env y llena los valores reales
# NUNCA subas .env a GitHub
# =============================================================

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@HOST:5432/promosolution?schema=promo_panel

# ── Servidor admin (Express) ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── API pública (n8n / bots / Julio) ─────────────────────────────────────────
# Genera con: openssl rand -hex 32
PUBLIC_API_KEY=ps_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sitio público Next.js ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://promosolution.com.mx
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_ADMIN_API=https://admin.promosolution.com.mx
# URL interna para SSR (Docker): si corre en Docker, usa http://admin:4000
# Si corre en local (npm run dev), déjalo en blanco (usará NEXT_PUBLIC_ADMIN_API)
ADMIN_API_URL=

# ── APIs Proveedores ──────────────────────────────────────────────────────────
# (estos se guardan en la BD — solo requeridos si se usan variables de entorno como fallback)

# 4 For Promotional
FORPROMOTIONAL_ID=22100

# Doble Vela
DOBLEVELA_CUENTA=C010535

# Innovation
INNOVATION_CUENTA=PECJ680416PZ6

# ── Email (buzones de cPanel/Neubox en el dominio real) ───────────────────────
# password se define al crear cada cuenta en cPanel. Todas comparten
# SMTP_HOST/SMTP_PORT (mismo servidor); solo VENTAS/SOPORTE son opcionales —
# si su PASS queda vacío, sendMail({..., account: 'ventas'}) simplemente no envía.
SMTP_HOST=mail.promosolution.com.mx
SMTP_PORT=465
SMTP_USER=admin@promosolution.com.mx
SMTP_PASS=
SMTP_USER_VENTAS=ventas@promosolution.com.mx
SMTP_PASS_VENTAS=
SMTP_USER_SOPORTE=soporte@promosolution.com.mx
SMTP_PASS_SOPORTE=
SMTP_USER_HOLA=hola@promosolution.com.mx
SMTP_PASS_HOLA=

# ── Julio (agente de ventas IA nativo) ────────────────────────────────────────
ANTHROPIC_API_KEY=
# Opcional — override del modelo (default: claude-sonnet-5)
JULIO_MODEL=
TELEGRAM_BOT_TOKEN=
# Secret que Telegram reenvía en el header X-Telegram-Bot-Api-Secret-Token —
# se define al registrar el webhook (setWebhook) y se valida aquí para
# confirmar que la petición viene realmente de Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Facebook Messenger + Instagram Messaging (comparten la misma Meta App/Página)
# Los 3 se generan en developers.facebook.com, en la App con productos
# "Messenger" e "Instagram" habilitados, apuntando a la Página de Facebook
# de Promo Solution (con la cuenta de Instagram Business ya vinculada a ella).
# Page Access Token — Messenger > Configuración de la API > Tokens de acceso
META_PAGE_ACCESS_TOKEN=
# Configuración básica de la App > Clave secreta de la app
META_APP_SECRET=
# String propio (cualquier valor que tú inventes) que se captura en la config
# del webhook en Meta — confirma el handshake inicial (GET con hub.challenge)
META_WEBHOOK_VERIFY_TOKEN=
