generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["promo_panel"]
}

// ─── Usuarios ────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(SELLER)
  isActive  Boolean  @default(true)
  quotes    Quote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("promo_panel")
}

enum Role {
  ADMIN
  SALES_MANAGER
  SELLER

  @@schema("promo_panel")
}

// ─── Proveedores y Catálogo ───────────────────────────────────────────────────

model Provider {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  authType     AuthType   @default(BEARER)
  apiUrl       String?
  apiKey       String?    // Token Bearer pre-emitido (Innovation, 4Promotional)
  apiUser      String?    // Email/usuario para login (Promo Option, Doble Vela)
  apiPassword  String?    // Contraseña para login
  accountId    String?    // ID de cuenta del cliente (Doble Vela: C010535, 4Promo: 22100)
  logo         String?
  isActive     Boolean    @default(true)
  lastSync     DateTime?
  syncStatus   SyncStatus @default(IDLE)
  syncMessage  String?
  totalProducts Int       @default(0)
  products     Product[]
  syncLogs     SyncLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@schema("promo_panel")
}

enum AuthType {
  BEARER     // Token pre-emitido como Bearer (Innovation)
  GRAPHQL    // Login via GraphQL mutation → JWT (Promo Option)
  WEBSERVICE // Login → Web Service (Doble Vela, 4Promotional)
  MANUAL     // Sin API, importación manual desde Excel (catálogo propio)

  @@schema("promo_panel")
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  ERROR

  @@schema("promo_panel")
}

model SyncLog {
  id               String     @id @default(cuid())
  providerId       String
  provider         Provider   @relation(fields: [providerId], references: [id])
  status           SyncStatus
  message          String?
  productsAdded    Int        @default(0)
  productsUpdated  Int        @default(0)
  productsTotal    Int        @default(0)
  startedAt        DateTime   @default(now())
  finishedAt       DateTime?

  @@schema("promo_panel")
}

model Category {
  id              String    @id @default(cuid())
  name            String    @unique
  seoDescription  String?
  seoKeywords     String?
  utilityPercent  Decimal   @default(0) @db.Decimal(5, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@schema("promo_panel")
}

model Collection {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  seoDescription String?
  seoKeywords    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("promo_panel")
}

model Product {
  id          String           @id @default(cuid())
  providerId  String
  provider    Provider         @relation(fields: [providerId], references: [id])
  externalId  String
  name        String
  description String?
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  basePrice   Decimal          @db.Decimal(10, 2)
  stock       Int?
  isActive    Boolean          @default(true)
  isVisible   Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  images      ProductImage[]
  colors      ProductColor[]
  variants    ProductVariant[]
  quoteItems  QuoteItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([providerId, externalId])
  @@schema("promo_panel")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)

  @@schema("promo_panel")
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName String
  hex       String?

  @@schema("promo_panel")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  material  String?
  size      String?
  minQty    Int     @default(1)

  @@schema("promo_panel")
}

// ─── Servicios ────────────────────────────────────────────────────────────────

model Service {
  id          String      @id @default(cuid())
  name        String
  type        ServiceType
  unitPrice   Decimal     @db.Decimal(10, 2)
  description String?
  imageUrl    String?
  isActive    Boolean     @default(true)
  quoteItems  QuoteItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@schema("promo_panel")
}

enum ServiceType {
  ESTAMPADO
  BORDADO
  GRABADO
  SUBLIMACION
  OTRO

  @@schema("promo_panel")
}

// ─── Clientes ─────────────────────────────────────────────────────────────────

model Client {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  phone         String?
  company       String?
  markupPercent Decimal      @default(33) @db.Decimal(5, 2)
  status        ClientStatus @default(ACTIVO)
  quotes        Quote[]

  // Cuenta del sitio público — null mientras el cliente solo ha cotizado como invitado.
  // Mismo registro de Client de siempre: al crear cuenta se reconcilia por telefono/email
  // con el historial de cotizaciones existente (ver lib/quotes.js), no se duplica.
  password             String?
  resetToken           String?          @unique
  resetTokenExpiresAt  DateTime?
  sessions             ClientSession[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@schema("promo_panel")
}

model ClientSession {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@schema("promo_panel")
}

enum ClientStatus {
  ACTIVO
  INACTIVO
  POR_CONFIRMAR

  @@schema("promo_panel")
}

// ─── Configuración ───────────────────────────────────────────────────────────

model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@schema("promo_panel")
}

// ─── Páginas del sitio ────────────────────────────────────────────────────────

model Page {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  status         PageStatus @default(INACTIVE)
  isSystem       Boolean    @default(false)
  seoImageUrl    String?
  seoKeywords    String?
  seoDescription String?
  extraContent   String?    // JSON: slider slides, banner image, etc.
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@schema("promo_panel")
}

enum PageStatus {
  PUBLIC
  INACTIVE

  @@schema("promo_panel")
}

// ─── Cotizaciones ─────────────────────────────────────────────────────────────

model Quote {
  id        String      @id @default(cuid())
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id])
  sellerId  String?
  seller    User?       @relation(fields: [sellerId], references: [id])
  status    QuoteStatus @default(DRAFT)
  channels  Channel[]
  subtotal  Decimal     @db.Decimal(10, 2)
  iva       Decimal     @db.Decimal(10, 2)
  total     Decimal     @db.Decimal(10, 2)
  notes     String?
  items     QuoteItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@schema("promo_panel")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED

  @@schema("promo_panel")
}

enum Channel {
  EMAIL
  WHATSAPP
  TELEGRAM
  FACEBOOK
  INSTAGRAM

  @@schema("promo_panel")
}

model QuoteItem {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  markup    Decimal  @db.Decimal(5, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  printTechnique String?
  // Costo de la técnica de impresión al momento de cotizar (congelado — no
  // recalcula si el precio del Service cambia después). 0 = sin técnica.
  printUnitCost  Decimal  @default(0) @db.Decimal(10, 2)

  @@schema("promo_panel")
}

// ─── Julio (agente de ventas IA) ───────────────────────────────────────────────

model JulioMessage {
  id        String        @id @default(cuid())
  sessionId String        // identidad de canal (ej. chat.id de Telegram) — no ligado a Client hasta que se cotiza
  channel   Channel
  role      JulioRole
  content   String
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
  @@schema("promo_panel")
}

enum JulioRole {
  USER
  ASSISTANT
  TOOL

  @@schema("promo_panel")
}
